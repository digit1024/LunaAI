# Copy to telegram-bridge.env and fill in your values.
# Required:
TELEGRAM_BOT_TOKEN=your-bot-token-from-BotFather
LUNA_ADDRESS=localhost:8080
LUNA_API_KEY=your-luna-api-key

# Optional: restrict to specific Telegram user IDs (comma-separated).
# If unset, anyone can use the bot.
# ALLOWED_TELEGRAM_IDS=123456789,987654321
