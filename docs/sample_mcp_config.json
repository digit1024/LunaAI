{
  "mcpServers": {
    "shell": {
      "command": "uvx",
      "args": ["mcp-shell-server"],
      "env": {
        "ALLOW_COMMANDS": "ls,cat,pwd,grep,wc,touch,find,echo,mkdir,rmdir,cp,mv,rm,chmod,chown,git,ps,df,du,whoami,head,tail,sort,uniq,curl,wget,sqlite3,flatpak,python3,systemctl,cargo"
      }
    },
    "filesystem": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-filesystem", "/home/youruser"],
      "env": {}
    },
    "fetch": {
      "command": "uvx",
      "args": ["mcp-server-fetch"],
      "env": { "PYTHONIOENCODING": "utf-8" }
    },
    "skills": {
      "command": "uvx",
      "args": ["agent-skills-mcp"],
      "env": {
        "SKILL_FOLDER": "/home/youruser/.local/share/cosmic_llm/skills",
        "MODE": "tool"
      }
    },
    "markitdown": {
      "command": "npx",
      "args": ["-y", "markitdown-mcp-npx"],
      "env": {}
    },
    "search": {
      "command": "uvx",
      "args": ["free-search-mcp"],
      "env": {}
    },
    "cosmic-llm-memory": {
      "command": "/home/youruser/.local/share/cosmic_llm/bin/mcp_luna_history",
      "args": [],
      "env": {
        "COSMIC_LLM_DB_PATH": "/home/youruser/.local/share/cosmic_llm/conversations.db"
      }
    }
  }
}
